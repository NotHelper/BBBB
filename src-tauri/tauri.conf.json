{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brail Performance Monitor",
  "version": "0.1.0",
  "identifier": "com.brail.performance-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brail Performance Monitor",
        "width": 1200,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } },
    "shortDescription": "Lightweight Windows gaming performance monitor",
    "longDescription": "Brail Performance Monitor provides local CPU, memory, storage, network, battery and extensible GPU telemetry without cloud services."
  }
}
